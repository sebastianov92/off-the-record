{
  "name": "off-the-record-webos",
  "version": "0.1.0",
  "private": true,
  "description": "Off the Record for LG webOS: the karaoke screen, remote controls and a USB microphone with voice processing.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run typecheck && node tools/build.mjs",
    "package": "npm run build && node tools/package.mjs && node tools/release-manifest.mjs",
    "preview": "node tools/preview.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@webos-tools/cli": "3.2.6",
    "esbuild": "^0.27.0",
    "sharp": "0.35.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
